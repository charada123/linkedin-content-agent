# Copy to .env and fill in. Never commit the real .env.

# --- Claude API ---
# Required. Generate at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# --- LinkedIn ---
# Required to publish. OAuth 2.0 access token with the w_member_social scope
# (plus openid + profile if you want the agent to resolve your author URN).
LINKEDIN_ACCESS_TOKEN=

# Optional: your author URN, e.g. urn:li:person:AbC123. If omitted, the agent
# looks it up via the OpenID userinfo endpoint (needs openid/profile scopes).
# LINKEDIN_AUTHOR_URN=

# Optional overrides
# LINKEDIN_API_VERSION=202409
# LINKEDIN_VISIBILITY=PUBLIC        # or CONNECTIONS
# TOPIC_SELECTION=rotate            # or random
# TARGET_WORDS=130

# --- Explainer video posts ---
# Every Nth theory post is rendered as a silent 4:5 explainer video instead of
# plain text. Requires ffmpeg and (ideally) the Inter font. Ads are unaffected.
# THEORIES_PER_VIDEO=3
# VIDEO_BASELINE_THEORIES=14      # theory posts already made before video existed

# Canvas and palette (bare hex, no leading '#')
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1350
# VIDEO_BG=121110
# VIDEO_FG=F7F4EE
# VIDEO_ACCENT=E8B44A
# VIDEO_MUTED=8B857A
# VIDEO_BRAND=Harada Insights

# Watermark shown on every frame. Set empty to turn it off.
# VIDEO_WATERMARK=https://www.linkedin.com/in/kenzoharada
# VIDEO_WATERMARK_BADGE=true
# VIDEO_TOP_ANCHOR=0.14

# Fonts, if Inter is not installed
# VIDEO_FONT_DISPLAY=/path/to/InterDisplay-Bold.otf
# VIDEO_FONT_REGULAR=/path/to/Inter-Regular.otf
